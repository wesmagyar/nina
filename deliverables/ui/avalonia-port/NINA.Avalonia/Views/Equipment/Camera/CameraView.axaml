<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NINA.CustomControls.Avalonia.Controls;assembly=NINA.CustomControls.Avalonia"
             x:Class="NINA.Avalonia.Views.Equipment.Camera.CameraView">
    
    <ScrollViewer>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Camera Header Section -->
            <GroupBox Header="Camera" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Text="Camera" />
                    
                    <!-- Connector Control -->
                    <controls:Connector Grid.Column="1"
                                      ConnectCommand="{Binding ConnectCommand}"
                                      DisconnectCommand="{Binding DisconnectCommand}"
                                      Connected="{Binding Connected}"
                                      SelectedDevice="{Binding SelectedDevice}"
                                      Devices="{Binding Devices}"
                                      HasSetupDialog="{Binding HasSetupDialog}"
                                      SetupCommand="{Binding SetupCommand}"
                                      RefreshCommand="{Binding RefreshCommand}"
                                      SetupDialogOpen="{Binding SetupDialogOpen}"
                                      CancelCommand="{Binding CancelCommand}" />
                </Grid>
            </GroupBox>
            
            <!-- Camera Details Section -->
            <Grid Grid.Row="1" IsEnabled="{Binding Connected}">
                <StackPanel>
                    <!-- Camera Info -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Name:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding CameraName}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Description:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding CameraDescription}" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Driver Info:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding DriverInfo}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Driver Version:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding DriverVersion}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <!-- Sensor Info -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,10,0,5">
                        <TextBlock Text="Sensor Information" FontSize="16" FontWeight="Bold" />
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Sensor Type:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding SensorType}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Sensor Name:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding SensorName}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Resolution:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding CameraXSize} × {Binding CameraYSize}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Pixel Size:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding PixelSizeX} × {Binding PixelSizeY} µm" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <!-- Exposure Info -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,10,0,5">
                        <TextBlock Text="Exposure Information" FontSize="16" FontWeight="Bold" />
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Min Exposure:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding MinExposure}s" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Max Exposure:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding MaxExposure}s" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Max Binning:" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding MaxBinX} × {Binding MaxBinY}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>