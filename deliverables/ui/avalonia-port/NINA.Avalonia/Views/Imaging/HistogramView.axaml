<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="NINA.Avalonia.Views.Imaging.HistogramView">
    <Grid>
        <!-- Placeholder for histogram display -->
        <Panel Background="{DynamicResource BackgroundBrush}">
            <Path
                Width="50"
                Height="50"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{DynamicResource HistogramSVG}"
                Fill="{DynamicResource ButtonForegroundDisabledBrush}"
                Opacity="0.4"
                Stretch="Uniform" />
        </Panel>
    </Grid>
</UserControl>