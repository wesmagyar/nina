<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.CustomControls.Avalonia.Controls"
    x:Class="NINA.CustomControls.Avalonia.Controls.Connector"
    x:DataType="local:ConnectorVM">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Device Selection ComboBox -->
    <ComboBox
      Grid.Column="0"
      MinWidth="150"
      Margin="5"
      ItemsSource="{CompiledBinding Devices}"
      SelectedItem="{CompiledBinding SelectedDevice}"
      IsEnabled="{CompiledBinding !Connected}" />

    <!-- Refresh Button -->
    <Button
      Grid.Column="1"
      Margin="5"
      Content="🔄"
      Command="{CompiledBinding RefreshCommand}"
      ToolTip.Tip="Refresh device list" />

    <!-- Connect/Disconnect Button -->
    <Button
      Grid.Column="2"
      Margin="5"
      Content="{CompiledBinding ConnectButtonText}"
      Command="{CompiledBinding ConnectToggleCommand}"
      ToolTip.Tip="{CompiledBinding ConnectButtonToolTip}" />

    <!-- Setup Button -->
    <Button
      Grid.Column="3"
      Margin="5"
      Content="⚙️"
      Command="{CompiledBinding SetupCommand}"
      IsEnabled="{CompiledBinding HasSetupDialog}"
      ToolTip.Tip="Device setup" />

    <!-- Connection Status Indicator -->
    <TextBlock
      Grid.Column="4"
      Margin="10,0,0,0"
      VerticalAlignment="Center"
      Text="{CompiledBinding ConnectionStatusText}"
      Foreground="{CompiledBinding ConnectionStatusColor}" />
  </Grid>
</UserControl>